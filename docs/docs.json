{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Exchange API",
  "description": "Competitor-facing REST and WebSocket API documentation for the Exchange trading competition.",
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#1F7A5A"
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index",
          "reference/authentication",
          "reference/market-lifecycle",
          "reference/error-codes",
          "reference/recovery-and-resync"
        ]
      },
      {
        "group": "REST API",
        "pages": [
          "reference/rest-api",
          "rest/health",
          "rest/markets",
          "rest/user",
          "rest/positions",
          "rest/portfolio",
          "rest/leaderboard",
          "rest/open-orders",
          "rest/fills",
          "rest/submit-order",
          "rest/amend-order",
          "rest/cancel-order"
        ]
      },
      {
        "group": "WebSocket API",
        "pages": [
          "reference/websocket-api",
          "websocket/authenticate",
          "websocket/subscribe-l3",
          "websocket/unsubscribe-l3",
          "websocket/submit-order",
          "websocket/amend-order",
          "websocket/cancel-order",
          "websocket/server-messages"
        ]
      }
    ]
  }
}
